# Скопируйте этот файл в prime\.env и вставьте свои значения. .env не попадает в git.
# Пустая строка = функция выключена. Ничего не придумывайте: без значения ничего не отправляется.

# Claude API — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Telegram-бот — токен от @BotFather, ваш числовой ID
PRIME_TELEGRAM_TOKEN=
PRIME_TELEGRAM_OWNER=

# Home Assistant — адрес и долгосрочный токен
PRIME_HA_URL=
PRIME_HA_TOKEN=

# Уведомления на телефон и часы через приложение ntfy (длинное имя канала)
PRIME_NTFY_TOPIC=
